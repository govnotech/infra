# =========================================================
# General
# =========================================================

# Your domain, e.g. example.com
DOMAIN=

# =========================================================
# Layer 1 — Infrastructure
# =========================================================

# --- Traefik ---

# Public IP of the VPS
TRAEFIK_PUBLIC_IP=

# Tailscale IP of this machine, use `tailscale ip -4` to find it
TRAEFIK_TAILSCALE_IP=

# Cloudflare API token with Zone:DNS:Edit (for DNS-01 challenge)
CF_DNS_API_TOKEN=

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=

# =========================================================
# Layer 2 — Services
# =========================================================
